# AngelOne SmartAPI Configuration
# Copy this file to config.env and fill in your actual credentials

# AngelOne API Credentials
ANGELONE_API_KEY=your_api_key_here
ANGELONE_USERNAME=your_client_code_here
ANGELONE_PASSWORD=your_password_here
ANGELONE_TOTP_SECRET=your_totp_secret_here

# Trading Parameters
ENTRY_TIME=09:19:00
EXIT_TIME=15:15:00
INDIVIDUAL_SL_PCT=0.15
COMBINED_SL_PCT=0.25
TRAILING_SL_PCT=0.10
LOT_SIZE=15

# SuperTrend Indicator Parameters
SUPERTREND_PERIOD=10
SUPERTREND_MULTIPLIER=3

# Risk Management
MAX_DAILY_LOSS=50000
MAX_POSITIONS=2

# Logging
LOG_LEVEL=INFO
LOG_FILE=trading_log.txt